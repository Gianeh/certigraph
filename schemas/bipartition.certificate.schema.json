{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://certigraph.dev/schemas/bipartition.certificate.schema.json",
  "title": "CertiGraph bipartition certificate",
  "type": "object",
  "required": ["vertices", "edges", "color"],
  "properties": {
    "vertices": {"type": "array", "items": {"type": ["string", "number", "integer"]}, "uniqueItems": true},
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["u", "v"],
        "properties": {
          "u": {"type": ["string", "number", "integer"]},
          "v": {"type": ["string", "number", "integer"]}
        },
        "additionalProperties": false
      }
    },
    "color": {"type": "object"}
  },
  "additionalProperties": true
}
